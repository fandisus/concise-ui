{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "src/index.ts", "src/components/**/*.ts", "src/components/**/*.vue"],
  "exclude": ["src/__tests__/**"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  }
}
