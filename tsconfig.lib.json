{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "src/index.ts", "src/**/*.vue"],
  "exclude": ["src/__tests__/**", "src/App.vue", "src/main.ts"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  }
}
